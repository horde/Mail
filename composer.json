{
    "name": "horde/mail",
    "description": "Mail library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Mail",
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "smtp"
    ],
    "time": "2026-05-13",
    "repositories": [],
    "require": {
        "php": "^7.4 || ^8",
        "horde/eventdispatcher": "^1 || dev-FRAMEWORK_6_0",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/idna": "^2 || dev-FRAMEWORK_6_0",
        "horde/mime": "^3 || dev-FRAMEWORK_6_0",
        "horde/stream": "^2 || dev-FRAMEWORK_6_0",
        "horde/stream_filter": "^3 || dev-FRAMEWORK_6_0",
        "horde/translation": "^3 || dev-FRAMEWORK_6_0",
        "horde/util": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {
        "horde/smtp": "^2 || dev-FRAMEWORK_6_0",
        "horde/socket_client": "^3 || dev-FRAMEWORK_6_0"
    },
    "suggest": {
        "horde/smtp": "^2 || dev-FRAMEWORK_6_0",
        "horde/socket_client": "^3 || dev-FRAMEWORK_6_0",
        "horde/stream_wrapper": "^3 || dev-FRAMEWORK_6_0",
        "mikepultz/netdns2": "^2.0"
    },
    "autoload": {
        "psr-0": {
            "Horde_Mail": "lib/"
        },
        "psr-4": {
            "Horde\\Mail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Mail\\Test\\": "test/",
            "Horde\\Mail\\Test\\Fixtures\\": "test/fixtures/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}